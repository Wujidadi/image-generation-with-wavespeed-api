root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[dtgen]
indent_size = 4
indent_style = space

[*.py]
indent_size = 4
indent_style = space

[*.toml]
indent_size = 2
indent_style = space

[*.{json,jsonc}]
indent_size = 4
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.md]
indent_size = 2
indent_style = space
trim_trailing_whitespace = false

[*.txt]
insert_final_newline = false
trim_trailing_whitespace = true
